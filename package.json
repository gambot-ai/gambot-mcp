{
  "name": "gambot-mcp",
  "version": "1.8.0",
  "description": "Official WhatsApp Business API MCP server for AI agents. Send messages and templates, receive webhooks, and manage contacts, CRM and bots through the official WhatsApp Cloud API (Meta Business Solution Provider) - no WhatsApp Web, no QR sessions.",
  "mcpName": "io.github.gambot-ai/gambot-mcp",
  "type": "module",
  "bin": {
    "gambot-mcp": "dist/index.js",
    "gambot-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "tsc && node --test",
    "prepare": "tsc"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "whatsapp",
    "whatsapp-mcp",
    "whatsapp-api",
    "whatsapp-business-api",
    "whatsapp-cloud-api",
    "official-whatsapp-api",
    "whatsapp-webhooks",
    "whatsapp-templates",
    "whatsapp-chatbot",
    "ai-agents",
    "ai-agent",
    "agent-skills",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "chatgpt",
    "gemini",
    "copilot",
    "windsurf",
    "gambot",
    "crm"
  ],
  "homepage": "https://gambot.co.il/whatsapp-mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gambot-ai/gambot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gambot-ai/gambot-mcp/issues"
  },
  "author": "Gambot (https://gambot.co.il)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
